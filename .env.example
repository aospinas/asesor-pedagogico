# Copia este archivo como .env y llena los valores. El .env NUNCA se sube a GitHub.

# --- IA (RF-19) ---
# openai | ollama | openrouter
LLM_PROVIDER=openai
LLM_MODEL=
# OpenAI: https://api.openai.com/v1 | Ollama: http://localhost:11434/v1 | OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# Cuántos segundos se espera una respuesta de la IA antes de rendirse
LLM_TIEMPO_SEG=60
# Precio por millón de tokens del modelo elegido (para el panel de costos)
LLM_PRECIO_ENTRADA_USD=
LLM_PRECIO_SALIDA_USD=

# --- Base de datos y archivos (Supabase) ---
# En el PC (docker compose up -d db). Va 127.0.0.1 y no localhost: en Windows,
# localhost prueba primero otra dirección y cada conexión tarda 30 segundos.
DATABASE_URL=postgresql+psycopg://asesor:asesor_local@127.0.0.1:5432/asesor
# En Render se pone la de Supabase:
# DATABASE_URL=postgresql+psycopg://usuario:clave@host:5432/postgres

# Dónde se guardan los archivos de las entregas:
# local (en el PC, en la carpeta ALMACEN_CARPETA) | supabase (en Render: el disco de Render se borra)
ALMACEN=local
ALMACEN_CARPETA=almacen_local
# Solo para ALMACEN=supabase. La dirección es https://<ref>.supabase.co (Project Settings > Data API)
# y la llave es la service_role (Project Settings > API Keys). El bucket debe ser PRIVADO.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=evidencias

# --- Seguridad ---
# desarrollo (en el PC) | produccion (en Render: exige JWT_SECRETO largo y cookie solo por HTTPS)
ENTORNO=desarrollo
# Mínimo 32 caracteres en producción. En el PC, si queda vacío, la app inventa uno al arrancar.
JWT_SECRETO=
# Cuánto dura una sesión abierta
SESION_MINUTOS=480
# Desde qué página se puede usar la API. En Render debe ser la dirección https de la app,
# por ejemplo https://asesor-pedagogico.onrender.com (en producción no se acepta * ni http).
ORIGENES_PERMITIDOS=http://localhost:5173
# Qué tan lento es el resumen de las contraseñas (más alto = más seguro y más lento). No hace falta cambiarlo.
# BCRYPT_RONDAS=12

# --- Pruebas ---
# Solo para correr las pruebas contra PostgreSQL antes de un PR. La base debe terminar en _pruebas:
# las pruebas BORRAN sus tablas. Se crea con: docker compose exec db createdb -U asesor asesor_pruebas
# PRUEBAS_DATABASE_URL=postgresql+psycopg://asesor:asesor_local@127.0.0.1:5432/asesor_pruebas

# --- Sandbox ---
# docker (en el PC) | proceso (en Render)
SANDBOX_MODE=docker
# Tiempo total para revisar una entrega (sintaxis, ruff y pytest) y memoria por corrida
SANDBOX_TIEMPO_SEG=60
SANDBOX_MEMORIA_MB=256
# Imagen del modo docker. Se crea con: docker build -t asesor-sandbox:1 -f sandbox.Dockerfile .
SANDBOX_IMAGEN=asesor-sandbox:1
# Ejecutar las pruebas del estudiante (true en el PC; false en Render, D-18)
SANDBOX_PRUEBAS=true

# Equipos donde puede estar Ollama, separados por coma. La app no acepta otra dirección para Ollama.
OLLAMA_HOSTS_PERMITIDOS=localhost,127.0.0.1
